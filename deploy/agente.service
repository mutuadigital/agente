[Unit]
Description=Agente de Suporte Mútua Digital
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/agente
EnvironmentFile=/var/www/agente/.env
ExecStart=/var/www/agente/venv/bin/python /var/www/agente/run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
