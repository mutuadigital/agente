{
  "name": "Agente Mútua — Responder Chamado",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Responder Chamado — Mútua Digital",
        "formDescription": "Preencha para enviar a resposta ao cliente via WhatsApp.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Número do Chamado (ticket_id)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Mensagem para o cliente",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Novo status",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "em_andamento" },
                  { "option": "resolvido" },
                  { "option": "fechado" },
                  { "option": "aberto" }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "responseText": "✅ Resposta enviada ao cliente com sucesso!"
            }
          }
        }
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Formulário de Resposta",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [240, 300],
      "webhookId": "form-responder-chamado"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r-field-001",
              "name": "ticket_id",
              "value": "={{ $json['Número do Chamado (ticket_id)'] }}",
              "type": "number"
            },
            {
              "id": "r-field-002",
              "name": "message",
              "value": "={{ $json['Mensagem para o cliente'] }}",
              "type": "string"
            },
            {
              "id": "r-field-003",
              "name": "status",
              "value": "={{ $json['Novo status'] }}",
              "type": "string"
            },
            {
              "id": "r-field-004",
              "name": "sender",
              "value": "suporte",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Montar Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agente.mutua.digital/webhook/ticket-update",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "values": [
            {
              "name": "ticket_id",
              "value": "={{ $json.ticket_id }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "status",
              "value": "={{ $json.status }}"
            },
            {
              "name": "sender",
              "value": "={{ $json.sender }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "Enviar Resposta ao Agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Resposta OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "value": "GOOGLE_SHEET_ID_AQUI",
          "__rl": true,
          "mode": "id"
        },
        "sheetName": {
          "value": "Chamados",
          "__rl": true,
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "={{ $('Montar Payload').item.json.status }}"
          }
        },
        "where": {
          "values": [
            {
              "lookupColumn": "ID",
              "lookupValue": "={{ $('Montar Payload').item.json.ticket_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Atualizar Status no Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 220],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets Mútua"
        }
      }
    },
    {
      "parameters": {
        "content": "## ❌ Falha ao enviar resposta\n\nO agente retornou um erro. Verifique se o servidor está online e o ticket_id é válido.",
        "height": 100,
        "width": 320
      },
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Nota de Erro",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1120, 420]
    }
  ],
  "pinData": {},
  "connections": {
    "Formulário de Resposta": {
      "main": [
        [
          {
            "node": "Montar Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar Payload": {
      "main": [
        [
          {
            "node": "Enviar Resposta ao Agente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Resposta ao Agente": {
      "main": [
        [
          {
            "node": "Resposta OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resposta OK?": {
      "main": [
        [
          {
            "node": "Atualizar Status no Sheets",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "v1-responder-chamado",
  "id": "workflow-responder-chamado",
  "tags": ["mutua-agente"]
}
